Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-security.ArrayBound,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-*,
  -cppcoreguidelines-pro-type-vararg,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-designated-initializers,
  -modernize-use-ranges,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-trailing-comma
WarningsAsErrors: ''
# cppcoreguidelines-pro-bounds-* flag every [] index and pointer step. Chess code indexes
# 64-square arrays constantly, and .at() everywhere would cost speed in hot loops; ASan in the
# ci-core job catches real out-of-bounds access instead.
# modernize-use-ranges is off because Apple's libc++ (AppleClang 17) lacks most std::ranges
# algorithms (ranges::reverse, ranges::any_of, views::reverse), so its suggestions don't compile.
# modernize-use-designated-initializers and readability-trailing-comma are style rules that
# would make small tables ({1, "!"}) and test data much longer without catching bugs.
# The two clang-analyzer checks are off because they report false positives inside
# chess-library (chess.hpp guards those paths with asserts), and analyzer findings in a
# header can't be filtered by location. ASan in the ci-core job covers real out-of-bounds bugs.
# misc-no-recursion is off because chess code walks trees (perft, game tree, PGN variations),
# where recursion is the natural fit.
HeaderFilterRegex: '(core|app|tests|bench)/.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m_
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
