Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-security.ArrayBound,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-vararg,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity
WarningsAsErrors: ''
# The two clang-analyzer checks are off because they report false positives inside
# chess-library (chess.hpp guards those paths with asserts), and analyzer findings in a
# header can't be filtered by location. ASan in the ci-core job covers real out-of-bounds bugs.
# misc-no-recursion is off because chess code walks trees (perft, game tree, PGN variations),
# where recursion is the natural fit.
HeaderFilterRegex: '(core|app|tests|bench)/.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m_
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
